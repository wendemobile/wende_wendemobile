    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "clean": "rimraf .next node_modules/.cache tsconfig.tsbuildinfo",
    "cert:generate": "tailscale cert tomgeneraltrading.tail572bbf.ts.net",
