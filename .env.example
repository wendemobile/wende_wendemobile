# Database - PostgreSQL
# For Supabase/Vercel, use the Transaction Pooler (port 6543) for DATABASE_URL
DATABASE_URL="postgresql://pos_user:pos_password@localhost:5432/pos_db"
# Use the Session Pooler (port 5432) for DIRECT_URL for migrations
DIRECT_URL="postgresql://pos_user:pos_password@localhost:5432/pos_db"

# NextAuth Configuration
# NEXTAUTH_URL should be set to your primary access URL
# For local development: http://localhost:3000
# For Tailscale: http://YOUR_TAILSCALE_IP:3000
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# Trusted hosts for authentication (comma-separated)
# Add all hosts you want to access the app from
# Example: localhost, Tailscale IP, Tailscale hostname
TRUSTED_HOSTS="localhost:3000,127.0.0.1:3000,YOUR_TAILSCALE_IP:3000,YOUR_HOSTNAME:3000"

# PostgreSQL credentials (for docker-compose)
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=pos_password
POSTGRES_DB=pos_db

# Supabase Storage Variables (Required for Vercel Deployment)
# Get these from Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="your-project-url"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Telegram Notification Configuration
TELEGRAM_BOT_TOKEN="your_bot_token"
TELEGRAM_CHAT_ID="your_target_chat_or_group_id"
